QWidget {
    background-color: #f4f6ff;
}

QPushButton {
    background-color: #007BFF;
    color: #f4f6ff;
    border-radius: 20px;
    padding: 15px;
    font-size: 18px;
}

QPushButton:hover {
    background-color: #0056b3;
}

QLabel {
    color: #333;
}

QProgressBar {
    border: 2px solid #007BFF;
    border-radius: 10px;
    background-color: #f5f5f5;
    height: 30px;
}

QProgressBar::chunk {
    background-color: #007BFF;
    border-radius: 10px;
}